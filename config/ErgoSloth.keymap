        jp_flick_layer {
            display-name = "JP_FLICK";

            // -------------------------------------------------------------------------------------------------------
            // |  ESC |  DEL |  F4  |  F5  |  F6  |  F7  | ,.?! |   |  F8  |  F9  |  F10 |  F11 |  - _ |  DEL | RCLK |
            // |  E/J | BKSP | GOff |  <>  | SMLL |  NN  |  WA  |   |  E/J | GOff |  <>  | SMLL |  NN  | BKSP | LCLK |
            // |  TAB |  Num |   A  |  KA  |  SA  | DkTn | SPCE |   |  ALT |   A  |  KA  |  SA  | DkTn | ENTR | SPCE |
            // | SHFT | SPCE |  TA  |  NA  |  HA  |   -  | LCLK |   |  Num |  TA  |  NA  |  HA  |   ↑  | SPCE | ,.?! |
            // |  ALT | ENTR |  MA  |  YA  |  RA  |  Num | RCLK |   |  Num |  MA  |  YA  |  RA  |   ↓  |   →  |  WA  |
            // | CmL1 | CmL2 | CmL3 | CmL4 | ENTR |  lyr | SPCE |   | CmR1 | CmR2 | CmR3 | CmR4 |  F5  |  lyr |   ←  |

            bindings = <
&kp ESC    	   &fl_delete  			   &td_f4  	  		   &td_f5  	   	 &td_f6       &td_f7     &td_fl_comma	&td_f8    	   &morph_f9  		   &morph_f10    &td_f11	  &morph_end_jis  &fl_delete     		  &mkp RCLK
&kp JP_HANZEN  &kp BACKSPACE  		   &mouse_gesture_off  &td_fl_kakko	 &mt X X	  &mc_nn  	 &morph_wa_0	&kp JP_HANZEN  &mouse_gesture_off  &td_fl_kakko	 &mt X X	  &mc_nn          &kp BACKSPACE  		  &mkp LCLK
&kp TAB        &kp LCTRL			   &morph_a_1   	   &morph_ka_2   &morph_sa_3  &kt LSHFT  &fl_space	    &kp LALT	   &morph_a_1   	   &morph_ka_2   &morph_sa_3  &kt LSHFT       &lt_fl_enter FUNCS_L 0  &fl_space
&kp LSHFT      &fl_space  			   &morph_ta_4  	   &morph_na_5   &morph_ha_6  &kp MINUS  &mkp LCLK 		&kp RCTRL	   &morph_ta_4     	   &morph_na_5   &morph_ha_6  &kp UP          &fl_space	  			  &td_fl_comma
&kp LALT       &lt_fl_enter FUNCS_L 0  &morph_ma_7  	   &morph_ya_8   &morph_ra_9  &kp RCTRL  &mkp RCLK		&kp LCTRL	   &morph_ma_7  	   &morph_ya_8   &morph_ra_9  &kp DOWN        &kp RIGHT   	  		  &morph_wa_0
&none	       &none  	 			   &none	 	  	   &none	 	 &kp ENTER    &tog_fl_l  &fl_space		&none          &none          	   &none         &none        &kp F5          &tog_fl_l   			  &kp LEFT
            >;

            sensor-bindings =
                <&enc_sagcs>,
                <&enc_sagcs>;
        };

