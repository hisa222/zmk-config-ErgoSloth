        win_v: windows_v {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_press &kp LGUI>,
                <&macro_tap &kp V>,
                <&macro_release &kp LGUI>;
        };

		mo_fun_alt: momentary_function_layer_alt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
			bindings = 
				<&macro_press &mo FUNCS_L &kp LALT>,
			    <&macro_pause_for_release>,
			    <&macro_release &mo FUNCS_L &kp LALT>;
		};

