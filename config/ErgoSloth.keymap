    /**************************************************************************/

    behaviors {
// hold_tap
        mt_c: mod_tap_custom {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <400>;
            bindings = <&kp>, <&kp>;
            display-name = "Mod-Tap";
        };

        mt_fl_a: mod_tap_flick_a {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <0>;
            flavor = "FLICK_LOGIC";
            tapping-term-ms = <400>;
            bindings = <&none>, <&kp A>;
            display-name = "Mod-Tap";
        };
        mt_fl_ka: mod_tap_flick_ka {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <0>;
            flavor = "FLICK_LOGIC";
            tapping-term-ms = <400>;
            bindings = <&kp K>, <&fl_ka>;
            display-name = "Mod-Tap";
        };
        mt_fl_sa: mod_tap_flick_sa {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <0>;
            flavor = "FLICK_LOGIC";
            tapping-term-ms = <400>;
